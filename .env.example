# ===========================================================================
#  .env.example  —  환경설정 템플릿 (이 파일은 git에 올라갑니다)
# ===========================================================================
#
#  사용법
#    1) 이 파일을 복사해서 .env 로 이름을 바꾼다
#         cp .env.example .env          (Windows:  copy .env.example .env)
#    2) .env 안의 값을 자기 환경에 맞게 고친다
#    3) 실행할 때 아래처럼 .env 를 지정한다
#         flutter run --dart-define-from-file=.env
#
#  ⚠️ .env 파일에는 개인 IP가 들어가므로 git에 올리지 않습니다(.gitignore 처리됨).
#     값을 바꿨을 때는 .env 가 아니라 이 .env.example 을 고쳐서 공유하세요.
# ===========================================================================


# ── 백엔드 서버 IP ─────────────────────────────────────────────────────────
#  상황별로 넣어야 하는 값이 다릅니다. 하나만 골라서 쓰세요.
#
#    안드로이드 에뮬레이터  +  서버가 내 PC에서 도는 경우   → 10.0.2.2
#      (에뮬레이터에서 127.0.0.1 은 에뮬레이터 자신을 가리켜서 안 됩니다)
#
#    실제 안드로이드 폰      +  서버가 내 PC에서 도는 경우   → 내 PC의 실제 IP
#      (mac:  ipconfig getifaddr en0   /   Windows:  ipconfig)
#      폰과 PC가 반드시 같은 Wi-Fi 에 있어야 합니다.
#
#    서버를 팀원이 돌리는 경우                              → 그 팀원 PC의 IP
#      (공유기 재접속 등으로 수시로 바뀔 수 있으니 그때그때 확인)
#
SERVER_IP=192.168.0.6


# ── 포트 ───────────────────────────────────────────────────────────────────
#  서버 담당자가 바꾸지 않았다면 아래 값 그대로 두면 됩니다.
REST_PORT=12345      # HTTP REST API 포트 (로그인/회원가입/로봇제어/대시보드)
MQTT_PORT=1883       # MQTT 브로커 포트 (실시간 센서값 / 병충해 알림)
